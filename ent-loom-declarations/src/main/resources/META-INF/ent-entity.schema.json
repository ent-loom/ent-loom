{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ent-loom 实体声明",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "crud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "anyOf": [
                {
                  "enum": [
                    "LIST",
                    "PAGE",
                    "FIND_ONE",
                    "DETAIL",
                    "CREATE",
                    "UPDATE",
                    "DELETE",
                    "UPDATE_BATCH",
                    "SAVE_OR_UPDATE",
                    "CREATE_BATCH",
                    "DELETE_BATCH",
                    "SAVE_OR_UPDATE_BATCH"
                  ]
                },
                {
                  "pattern": "^(?:[Ll][Ii][Ss][Tt]|[Pp][Aa][Gg][Ee]|[Ff][Ii][Nn][Dd][-_][Oo][Nn][Ee]|[Dd][Ee][Tt][Aa][Ii][Ll]|[Cc][Rr][Ee][Aa][Tt][Ee]|[Uu][Pp][Dd][Aa][Tt][Ee]|[Dd][Ee][Ll][Ee][Tt][Ee]|[Uu][Pp][Dd][Aa][Tt][Ee][-_][Bb][Aa][Tt][Cc][Hh]|[Ss][Aa][Vv][Ee][-_][Oo][Rr][-_][Uu][Pp][Dd][Aa][Tt][Ee]|[Cc][Rr][Ee][Aa][Tt][Ee][-_][Bb][Aa][Tt][Cc][Hh]|[Dd][Ee][Ll][Ee][Tt][Ee][-_][Bb][Aa][Tt][Cc][Hh]|[Ss][Aa][Vv][Ee][-_][Oo][Rr][-_][Uu][Pp][Dd][Aa][Tt][Ee][-_][Bb][Aa][Tt][Cc][Hh])$"
                }
              ]
            },
            "description": "该业务动作映射的标准操作；空列表关闭此动作的通用映射。"
          },
          "description": "按业务动作配置标准操作映射。省略或空对象沿用策略缺省；动作值为空列表时保留业务动作并关闭其通用映射；批量操作需显式声明。"
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$",
            "description": "Java 关系属性名称，例如 customerId。"
          },
          "description": "关系角色到 Java 关系属性的映射，仅声明实体与策略之间的差异。属性是否存在由启动校验。"
        },
        "ownership": {
          "$ref": "#/$defs/fields",
          "description": "归属角色列表；省略使用框架推导，空列表关闭推导，但不取消底层范围约束。列表填写角色码。"
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input-required-fields": {
                  "$ref": "#/$defs/fields",
                  "description": "创建时必须显式输入的 Java 属性名；不替代其他输入校验。"
                }
              },
              "description": "创建输入契约。"
            },
            "update": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "forbidden-fields": {
                  "$ref": "#/$defs/fields",
                  "description": "更新时禁止修改的 Java 属性名。"
                }
              },
              "description": "更新输入契约。"
            }
          },
          "description": "实体输入契约：创建时显式要求输入的字段，以及更新时禁止修改的字段。"
        },
        "http-exposed": {
          "type": "boolean",
          "default": true,
          "description": "是否开放实体及全部别名的通用 HTTP，默认 true；false 关闭通用 HTTP。仍受全局 controller.enabled 控制；此项不授予权限，也不关闭自定义控制器。"
        },
        "allowed-operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "LIST",
                  "PAGE",
                  "FIND_ONE",
                  "DETAIL",
                  "CREATE",
                  "UPDATE",
                  "DELETE",
                  "UPDATE_BATCH",
                  "SAVE_OR_UPDATE",
                  "CREATE_BATCH",
                  "DELETE_BATCH",
                  "SAVE_OR_UPDATE_BATCH"
                ]
              },
              {
                "pattern": "^(?:[Ll][Ii][Ss][Tt]|[Pp][Aa][Gg][Ee]|[Ff][Ii][Nn][Dd][-_][Oo][Nn][Ee]|[Dd][Ee][Tt][Aa][Ii][Ll]|[Cc][Rr][Ee][Aa][Tt][Ee]|[Uu][Pp][Dd][Aa][Tt][Ee]|[Dd][Ee][Ll][Ee][Tt][Ee]|[Uu][Pp][Dd][Aa][Tt][Ee][-_][Bb][Aa][Tt][Cc][Hh]|[Ss][Aa][Vv][Ee][-_][Oo][Rr][-_][Uu][Pp][Dd][Aa][Tt][Ee]|[Cc][Rr][Ee][Aa][Tt][Ee][-_][Bb][Aa][Tt][Cc][Hh]|[Dd][Ee][Ll][Ee][Tt][Ee][-_][Bb][Aa][Tt][Cc][Hh]|[Ss][Aa][Vv][Ee][-_][Oo][Rr][-_][Uu][Pp][Dd][Aa][Tt][Ee][-_][Bb][Aa][Tt][Cc][Hh])$"
              }
            ]
          },
          "description": "标准操作白名单。省略不额外限制；空列表关闭全部标准操作。开放操作不等于授予权限，业务动作通过 actions 声明。"
        },
        "actions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "动作展示名称，例如下单。"
              },
              "entries": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "capability": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:.*\\S)?$",
                      "description": "所需能力码，例如 place-order。",
                      "examples": [
                        "place-order"
                      ]
                    },
                    "portals": {
                      "$ref": "#/$defs/fields",
                      "description": "允许的可信入口类型，例如 http；省略或空列表表示不限制可信入口类型。"
                    }
                  },
                  "required": [
                    "capability"
                  ],
                  "description": "该入口执行动作所需的能力和允许的传输入口。"
                },
                "description": "按入口码配置能力；入口码以字母开头，仅含字母、数字、下划线和连字符。"
              }
            },
            "required": [
              "name",
              "entries"
            ],
            "description": "单个业务动作，必须声明中文名称和至少一个入口。"
          },
          "description": "业务动作及入口能力声明。空对象关闭动作；动作码忽略大小写后不得重复，Handler 仍通过 Java 注解注册。"
        },
        "access": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/accessSubject"
          },
          "properties": {
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "actions": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "add": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "remove": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                }
              ],
              "description": "仅实体层支持：省略继承策略，列表整体替换（空列表关闭），对象先 add 后 remove；未知动作和通配符拒绝。增量声明跟随策略演进。"
            }
          },
          "description": "按访问主体聚合授权；policy 选择共享策略，actions 调整实体动作集合，其余键为身份码或 public。"
        }
      },
      "description": "实体访问治理、通用 HTTP 暴露、操作和输入契约。有 crud 对象声明才默认发布 HTTP；选择 access.policy 或继承全局 default-policy，开放接口不代表授予权限。"
    },
    "ddl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indexes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "索引名称；省略由框架命名。"
              },
              "fields": {
                "allOf": [
                  {
                    "$ref": "#/$defs/fields"
                  }
                ],
                "minItems": 1,
                "description": "索引使用的 Java 持久化属性名，至少一个；与 expression 互斥。"
              },
              "expression": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "原生索引表达式；与 fields 互斥。"
              },
              "unique": {
                "type": "boolean",
                "default": false,
                "description": "是否唯一索引，默认 false。"
              }
            },
            "oneOf": [
              {
                "required": [
                  "fields"
                ],
                "not": {
                  "required": [
                    "expression"
                  ]
                }
              },
              {
                "required": [
                  "expression"
                ],
                "not": {
                  "required": [
                    "fields"
                  ]
                }
              }
            ],
            "description": "单个索引；fields 与 expression 必须且只能选择一个。"
          },
          "description": "实体索引列表；字段名使用 Java 持久化属性，框架转换为物理列名。"
        }
      },
      "description": "DDL 声明差异；需启用对应 DDL 组件。"
    },
    "doc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "description": "展示名称。"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "description": "展示说明。"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "description": "文档分组。"
        },
        "remark": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "description": "补充备注。"
        },
        "hidden": {
          "type": "boolean",
          "description": "是否在文档中隐藏；不改变接口访问权限。"
        },
        "visible-for": {
          "$ref": "#/$defs/fields",
          "description": "文档可见身份列表；不代表授予接口权限。"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "展示名称。"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "展示说明。"
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "文档分组。"
              },
              "remark": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "补充备注。"
              },
              "hidden": {
                "type": "boolean",
                "description": "是否在文档中隐藏；不改变接口访问权限。"
              },
              "visible-for": {
                "$ref": "#/$defs/fields",
                "description": "文档可见身份列表；不代表授予接口权限。"
              },
              "example": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "单个展示示例，需使用字符串；数字示例也应加引号。"
              },
              "examples": {
                "$ref": "#/$defs/fields",
                "description": "多个字符串展示示例。"
              },
              "target-entity-label": {
                "type": "string",
                "minLength": 1,
                "description": "关系目标实体的展示名称。"
              },
              "relation-remark": {
                "type": "string",
                "minLength": 1,
                "description": "关系展示备注。"
              }
            },
            "description": "单个 Java 属性的文档展示差异。"
          },
          "description": "按 Java 属性名声明文档展示差异；字段存在性由启动校验。"
        }
      },
      "description": "实体文档展示差异；省略的展示项沿用原有元数据，不改变访问权限。"
    }
  },
  "$defs": {
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "description": "非空字符串，不得包含首尾空白。"
      },
      "description": "不重复的非空字符串列表；不得包含首尾空白，具体字段或角色含义以使用位置为准。"
    },
    "fieldPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "EXCLUDE",
          "description": "INCLUDE 仅包含列表字段；EXCLUDE 排除列表字段（默认）；ALL 全部候选字段；NONE 关闭该用途。",
          "examples": [
            "INCLUDE"
          ],
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "INCLUDE",
                "EXCLUDE",
                "ALL",
                "NONE"
              ]
            },
            {
              "pattern": "^(?:[Ii][Nn][Cc][Ll][Uu][Dd][Ee]|[Ee][Xx][Cc][Ll][Uu][Dd][Ee]|[Aa][Ll][Ll]|[Nn][Oo][Nn][Ee])$"
            }
          ]
        },
        "fields": {
          "$ref": "#/$defs/fields",
          "description": "Java 属性名列表；INCLUDE 必须非空，ALL/NONE 只能省略或为空。字段有效性由启动校验。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "type": "string",
                "anyOf": [
                  {
                    "enum": [
                      "INCLUDE"
                    ]
                  },
                  {
                    "pattern": "^(?:[Ii][Nn][Cc][Ll][Uu][Dd][Ee])$"
                  }
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "type": "string",
                "anyOf": [
                  {
                    "enum": [
                      "ALL",
                      "NONE"
                    ]
                  },
                  {
                    "pattern": "^(?:[Aa][Ll][Ll]|[Nn][Oo][Nn][Ee])$"
                  }
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "fields": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "description": "字段授权方案；mode 默认 EXCLUDE。INCLUDE 必须有非空 fields；ALL/NONE 的 fields 必须省略或为空列表。"
    },
    "accessSubject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "add": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "remove": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "all 表示全部记录，其余值引用共享关系；省略继承，不隐式放开范围。"
        },
        "rules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 1
              }
            ]
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "RETURN": {
              "$ref": "#/$defs/fieldPlan",
              "description": "返回字段的授权方案；候选范围仍受实体元数据与治理约束。"
            },
            "WRITE": {
              "$ref": "#/$defs/fieldPlan",
              "description": "可写字段的授权方案；候选范围仍受实体元数据与治理约束。"
            },
            "FILTER": {
              "$ref": "#/$defs/fieldPlan",
              "description": "过滤字段的授权方案；候选范围仍受实体元数据与治理约束。"
            },
            "SORT": {
              "$ref": "#/$defs/fieldPlan",
              "description": "排序字段的授权方案；候选范围仍受实体元数据与治理约束。"
            },
            "STATS": {
              "$ref": "#/$defs/fieldPlan",
              "description": "统计字段的授权方案；候选范围仍受实体元数据与治理约束。"
            },
            "EXPAND": {
              "$ref": "#/$defs/fieldPlan",
              "description": "关系展开字段的授权方案；候选范围仍受实体元数据与治理约束。"
            }
          },
          "description": "某一身份的字段用途权限；身份码是否有效由框架校验。用途推荐 RETURN/WRITE/FILTER/SORT/STATS/EXPAND，解析忽略大小写；同一用途不得重复声明。",
          "patternProperties": {
            "^(?:[Rr][Ee][Tt][Uu][Rr][Nn]|[Ww][Rr][Ii][Tt][Ee]|[Ff][Ii][Ll][Tt][Ee][Rr]|[Ss][Oo][Rr][Tt]|[Ss][Tt][Aa][Tt][Ss]|[Ee][Xx][Pp][Aa][Nn][Dd])$": {
              "$ref": "#/$defs/fieldPlan"
            }
          }
        }
      },
      "description": "同一访问主体的动作、范围、规则与字段；省略项独立继承默认和策略。fields 固定使用用途对象，不接受列表简写。"
    }
  },
  "description": "实体级 CRUD、DDL 和文档声明。文件名为实体资源码；结构与枚举由 Schema 校验，实体字段、策略引用及组件启用情况由框架启动校验。枚举推荐 Java 常量名大写形式，兼容大小写及连字符/下划线；归一化后的重复用途和操作由启动校验拒绝。"
}
