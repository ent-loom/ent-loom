@baseUrl = http://localhost:8080
@customerId = 1000000000001

### Read the subject-scoped entity documentation contract
GET {{baseUrl}}/api/ent-doc/contract
Accept: application/json

### Create a customer profile
POST {{baseUrl}}/api/ent-crud/customer_profile/create
Authorization: Bearer demo-profile-admin
Content-Type: application/json

{
  "payload": {
    "id": {{customerId}},
    "displayName": "Ada Lovelace",
    "email": "ada@example.com"
  }
}

### Read the profile created above
POST {{baseUrl}}/api/ent-crud/customer_profile/detail
Authorization: Bearer demo-profile-admin
Content-Type: application/json

{
  "id": {{customerId}}
}
