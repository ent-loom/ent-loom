<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>mini-commerce-spring-boot</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>mini-commerce-spring-boot</name>
    <description>Minimal ent-loom commerce consumer example</description>

    <properties>
        <java.version>21</java.version>
        <ent-loom.version>1.0.1</ent-loom.version>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.github.ent-loom</groupId>
            <artifactId>ent-loom-crud-core</artifactId>
            <version>${ent-loom.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.ent-loom</groupId>
            <artifactId>ent-loom-meta-spring-boot-starter</artifactId>
            <version>${ent-loom.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.ent-loom</groupId>
            <artifactId>ent-loom-crud-spring-boot-starter</artifactId>
            <version>${ent-loom.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.ent-loom</groupId>
            <artifactId>ent-loom-meta-annotations</artifactId>
            <version>${ent-loom.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.ent-loom</groupId>
            <artifactId>ent-loom-crud-api</artifactId>
            <version>${ent-loom.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.ent-loom</groupId>
            <artifactId>ent-loom-crud-annotations</artifactId>
            <version>${ent-loom.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
