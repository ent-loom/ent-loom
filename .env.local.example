# ent-loom 本地数据库配置模板
# 应用数据源配置
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ent-loom?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# MySQL 集成测试配置。必须指向隔离实例；测试会创建并删除随机 schema。
ENTLOOM_TEST_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
ENTLOOM_TEST_MYSQL_USERNAME=root
ENTLOOM_TEST_MYSQL_PASSWORD=change-me

ENT_LOOM_DB_TYPE=mysql
ENT_LOOM_DB_VERSION=8
ENT_LOOM_DB_HOST=localhost
ENT_LOOM_DB_PORT=3306
ENT_LOOM_DB_NAME=ent-loom
ENT_LOOM_DB_USERNAME=root
ENT_LOOM_DB_PASSWORD=change-me
